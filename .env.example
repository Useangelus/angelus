# Public site URL (used for metadata and share images)
NEXT_PUBLIC_SITE_URL=https://example.com

# $ANGELUS contract address on Robinhood Chain. Leave empty until launch.
NEXT_PUBLIC_TOKEN_CA=

# Storage for calls and nightly locks (Supabase). Publishable key only, no service-role key.
# Run supabase/schema.sql once, then: select private.angelus_set_token('<ANGELUS_DB_TOKEN>');
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Long random string, server-only. Every database function checks it.
ANGELUS_DB_TOKEN=

# Optional: WalletConnect for phones without a wallet browser (dashboard.reown.com).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional: social links. X defaults to https://x.com/useangelus; GitHub appears once set.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=

# Optional: the Vigil, one short AI-written note per stock each night at the lock.
ANTHROPIC_API_KEY=

# Protects /api/cron/* (Vercel sends it automatically to cron jobs).
CRON_SECRET=

# Optional: the nightly on-chain seal (contracts/src/BellRegistry.sol on Robinhood Chain).
# Contract address, shown on the Method page; sealing is off while empty.
NEXT_PUBLIC_BELL_REGISTRY=
# Private key of the keeper wallet set in the contract (server-only, holds a little ETH for gas, nothing else).
KEEPER_PRIVATE_KEY=
# RPC for Robinhood Chain; the public endpoint is rate-limited, a provider URL is better.
ROBINHOOD_RPC_URL=
